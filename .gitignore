*.egg-info/
__pycache__/
*.pyc
*.pyo
dist/
build/

# macOS resource forks
._*
.DS_Store

# Logs
*.log

# IDE/Editor
.vscode/
.idea/

# Temporary files
tmp/
*.tmp.*

# This file
.gitignore
.docker/
