# Data directories (large files, generated)
/data/
/output/
/opentopodata/

# Credentials and secrets
.credentials/
.env
.env.*

# Claude config (local)
.claude/

# Legacy/archive (escaped ! which has special meaning in gitignore)
\!old/

# Python build artifacts
*.egg-info/
__pycache__/
*.pyc
*.pyo
dist/
build/

# macOS resource forks
._*
.DS_Store

# Logs
*.log

# IDE/Editor
.vscode/
.idea/

# Temporary files
tmp/
*.tmp.*

# Next.js build output
.next
.next/
gui/.next/

# SMB filesystem deletion artifacts
.smbdelete*

# Test caches
tests/.pjamm_cache.json

# This file
.gitignore
.docker/
