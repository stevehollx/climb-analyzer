#!/bin/bash
# Climb Analyzer - Convenient wrapper script
# Makes it easy to run the climb analyzer without typing long docker commands

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Get the directory where this script is located
SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
cd "$SCRIPT_DIR"

# Function to print colored output (box-drawing style)
print_banner() {
    local width=80
    local text="$1"
    local text_upper=$(echo "$text" | tr '[:lower:]' '[:upper:]')  # Convert to uppercase (bash 3 compatible)
    local padding=$(( width - ${#text_upper} - 4 ))

    echo -e "${BLUE}┌$(printf '─%.0s' {1..78})┐${NC}"
    echo -e "${BLUE}│${NC} ${text_upper}$(printf ' %.0s' $(seq 1 $padding)) ${BLUE}│${NC}"
    echo -e "${BLUE}└$(printf '─%.0s' {1..78})┘${NC}"
    echo ""
}

print_header() {
    local width=80
    local text="$1"
    local padding=$(( width - ${#text} - 4 ))

    echo ""
    echo -e "${BLUE}┌$(printf '─%.0s' {1..78})┐${NC}"
    echo -e "${BLUE}│${NC} ${text}$(printf ' %.0s' $(seq 1 $padding)) ${BLUE}│${NC}"
    echo -e "${BLUE}└$(printf '─%.0s' {1..78})┘${NC}"
    echo ""
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠️ ${NC} $1"
}

print_info() {
    echo -e "$1"
}

# Function to check if Docker is running
check_docker() {
    local docker_output
    docker_output=$(docker info 2>&1)
    local exit_code=$?

    if [ $exit_code -ne 0 ]; then
        # Check if it's a permission issue
        if echo "$docker_output" | grep -qi "permission denied\|Got permission denied\|connect: permission denied"; then
            print_error "Docker permission denied - your user is not in the docker group"
            echo ""
            echo "To fix this, run:"
            echo "  sudo usermod -aG docker \$USER"
            echo ""
            echo "Then log out and log back in (or run 'newgrp docker' for current session)"
            echo "After that, run ./climb-analyzer setup again"
            exit 1
        elif echo "$docker_output" | grep -qi "Cannot connect\|connection refused\|Is the docker daemon running"; then
            print_error "Docker daemon is not running"
            echo ""
            echo "Please start Docker:"
            echo "  sudo systemctl start docker"
            echo ""
            echo "To enable Docker on boot:"
            echo "  sudo systemctl enable docker"
            exit 1
        else
            print_error "Docker is not accessible"
            echo ""
            echo "Error details: $docker_output"
            echo ""
            echo "Please ensure Docker is installed and running"
            exit 1
        fi
    fi
}

# Function to detect docker compose command (returns array-style command)
get_compose_cmd() {
    if docker compose version >/dev/null 2>&1; then
        echo "docker compose"
    elif command -v docker-compose >/dev/null 2>&1; then
        echo "docker-compose"
    else
        print_error "Docker Compose not found"
        echo "Please install Docker Compose and try again"
        exit 1
    fi
}

# Run docker compose command with proper argument handling
run_compose() {
    if docker compose version >/dev/null 2>&1; then
        docker compose "$@"
    else
        docker-compose "$@"
    fi
}

# Show help message
show_help() {
    cat << EOF
Climb Analyzer - Convenient wrapper script

Usage: ./climb-analyzer [command] [options]

Commands:
  run, start              Run climb analyzer interactively (default)
  setup                   Run setup wizard (first-time setup or change deployment mode)
  logo                    Display the 80s retro ASCII logo
  shell                   Open a shell inside the container
  logs                    View climb analyzer logs
  build                   Build/rebuild the Docker image
  stop                    Stop all running containers
  --stop-gui              Stop the GUI server (if running in background)
  --restart-gui           Restart the GUI server
  --merge-climbs, -M      Merge split climbs in an output file (single file)
  --merge-splits, -S      Merge split climbs across multiple output files
  --merge-regions, -X     Merge climbs across adjacent region files (batch)
  clean                   Remove containers and cleanup
  help, -h, --help        Show this help message

CLI Analysis (pass any climb_analyzer.py arguments):
  -a, --address                   Address-based analysis
  -r, --run-region                Region analysis (single or batch)
  -i, --interactive               Interactive mode (default)
  -g, --gui                       Launch web GUI (http://localhost:3000)
  -s, --surface-filter            Surface type filter
      --cycling-filter            Enable cycling filter
  -u, --units                     Unit system (metric/imperial)
  -t, --score-type                Scoring algorithm (basic/fiets/pdi)
  -m, --min-score                 Minimum score threshold
  -v, --verbose                   Show detailed technical output
      --list-regions              List all available regions and exit

Data Management:
  -U, --update-geo-boundaries     Update geographic boundaries
  -D, --data-download             Download data without analysis
  -c, --cleanup-checkpoints       Delete checkpoints for this region after analysis (use with -r)
  -Z, --cleanup-all-data          Delete all data for this region after analysis (use with -r)
      --ignore-checkpoints        Start fresh analysis, ignore existing checkpoints
      --no-cloud-upload           Skip uploading to cloud cache
  Note: Checkpoints are KEPT by default for potential resume.

Cleanup Subcommand (global deletion):
  cleanup --checkpoints           Delete ALL checkpoint files
  cleanup --elevation             Delete ALL elevation data
  cleanup --osm                   Delete ALL OSM data and indexes
  cleanup --all                   Delete ALL data

Examples:
  ./climb-analyzer                           # Run interactively
  ./climb-analyzer -g                        # Launch web GUI (background)
  ./climb-analyzer --stop-gui                # Stop GUI server
  ./climb-analyzer --restart-gui             # Restart GUI server
  ./climb-analyzer -a "Boulder, CO" --distance 25
  ./climb-analyzer -r Colorado -s paved
  ./climb-analyzer -r "VT,NH,ME" -Z          # Batch with cleanup after each region
  ./climb-analyzer -D -r Vermont             # Download data only
  ./climb-analyzer -U                        # Update boundaries
  ./climb-analyzer cleanup --all             # Delete all data globally
  ./climb-analyzer --merge-regions "output/state_*.xlsx"  # Merge cross-region climbs
  ./climb-analyzer --list-regions            # Show all available regions
  ./climb-analyzer --help-extended           # Extended help
  ./climb-analyzer setup                     # Run setup wizard
  ./climb-analyzer shell                     # Open shell
  ./climb-analyzer logs                      # View logs

For more detailed documentation, see:
  • CLI_ARGUMENTS_SPEC.md
  • DOCKER_SETUP.md
  • INSTALLATION.md

EOF
}

# Main command handling
COMPOSE_CMD=$(get_compose_cmd)

# Export host user/group IDs for Docker Compose to use
export HOST_UID=$(id -u)
export HOST_GID=$(id -g)

# Export Docker group ID for socket access (needed for rebuilding OpenTopoData from container)
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS: Docker Desktop runs Docker inside a Linux VM. The host socket's
    # GID doesn't translate to the VM, so we always use GID 0 (root group)
    # which reliably grants access to the Docker socket inside containers.
    export DOCKER_GID=0
else
    # Linux: Get the docker group GID
    if getent group docker >/dev/null 2>&1; then
        export DOCKER_GID=$(getent group docker | cut -d: -f3)
    elif [ -S /var/run/docker.sock ]; then
        export DOCKER_GID=$(stat -c '%g' /var/run/docker.sock)
    else
        export DOCKER_GID=999  # fallback
    fi
fi

# Create or update .env file with correct UID/GID if it doesn't exist
if [ ! -f ".env" ]; then
    if [ -f ".env.example" ]; then
        print_info "Creating .env file from .env.example with auto-detected UID/GID..."
        cp .env.example .env
        # Update the UID/GID in .env to match detected values
        if [[ "$OSTYPE" == "darwin"* ]]; then
            # macOS sed syntax
            sed -i '' "s/^HOST_UID=.*/HOST_UID=$HOST_UID/" .env
            sed -i '' "s/^HOST_GID=.*/HOST_GID=$HOST_GID/" .env
            sed -i '' "s/^DOCKER_GID=.*/DOCKER_GID=$DOCKER_GID/" .env
        else
            # Linux sed syntax
            sed -i "s/^HOST_UID=.*/HOST_UID=$HOST_UID/" .env
            sed -i "s/^HOST_GID=.*/HOST_GID=$HOST_GID/" .env
            sed -i "s/^DOCKER_GID=.*/DOCKER_GID=$DOCKER_GID/" .env
        fi
        print_success "Created .env with HOST_UID=$HOST_UID, HOST_GID=$HOST_GID, DOCKER_GID=$DOCKER_GID"
    fi
else
    # Existing .env file - ensure DOCKER_GID is set (may be missing from older .env files)
    if ! grep -q "^DOCKER_GID=" .env 2>/dev/null; then
        echo "" >> .env  # Ensure newline before appending
        echo "DOCKER_GID=$DOCKER_GID" >> .env
        print_info "Added DOCKER_GID=$DOCKER_GID to existing .env file"
    fi
fi

# Handle -h and --help flags for any command or standalone
if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]] || [[ "$2" == "-h" ]] || [[ "$2" == "--help" ]]; then
    show_help
    exit 0
fi

case "${1:-run}" in
    run|start|"")
        print_banner "Starting Climb Analyzer (Interactive Mode)"
        check_docker
        print_info "Launching climb analyzer in interactive mode..."
        echo ""
        exec $COMPOSE_CMD run --rm climb-analyzer
        ;;

    setup)
        print_banner "Running Setup Wizard"
        check_docker
        print_info "Launching setup wizard..."
        echo ""
        exec python3 setup_wizard.py
        ;;

    logo)
        # Display the 80s retro ASCII logo
        export PYTHONPATH="$SCRIPT_DIR"
        python3 -c "from climb_analyzer.utils.ascii_logo import print_logo; print_logo()"
        exit 0
        ;;

    --stop-gui)
        print_header "Stopping GUI Server"
        if [ -f "gui/gui-server.pid" ]; then
            GUI_PID=$(cat gui/gui-server.pid)
            if kill -0 $GUI_PID 2>/dev/null; then
                print_info "Stopping GUI server (PID: $GUI_PID)..."
                kill $GUI_PID
                rm -f gui/gui-server.pid
                print_success "GUI server stopped"
            else
                print_warning "GUI server not running (stale PID file)"
                rm -f gui/gui-server.pid
            fi
        else
            print_warning "No GUI server PID file found"
            print_info "Trying to stop by process name..."
            if pkill -f 'next dev' 2>/dev/null; then
                print_success "GUI server stopped"
            else
                print_warning "No GUI server process found"
            fi
        fi
        ;;

    --restart-gui)
        print_header "Restarting GUI Server"

        # First stop it
        if [ -f "gui/gui-server.pid" ]; then
            GUI_PID=$(cat gui/gui-server.pid)
            if kill -0 $GUI_PID 2>/dev/null; then
                print_info "Stopping existing GUI server (PID: $GUI_PID)..."
                kill $GUI_PID
                sleep 1
            fi
            rm -f gui/gui-server.pid
        else
            print_info "Stopping any running GUI servers..."
            pkill -f 'next dev' 2>/dev/null || true
            sleep 1
        fi

        # Then start it
        print_info "Starting GUI server..."
        echo ""
        exec $0 -g
        ;;

    --merge-climbs|-M)
        print_banner "Merging Split Climbs"

        # Check if file argument provided
        if [ -z "$2" ]; then
            print_error "No file specified"
            echo ""
            echo "Usage: ./climb-analyzer --merge-climbs <file>"
            echo "       ./climb-analyzer -M <file>"
            echo ""
            echo "Example:"
            echo "  ./climb-analyzer --merge-climbs output/France_climbs.xlsx"
            echo ""
            exit 1
        fi

        FILE_PATH="$2"
        shift 2  # Remove command and file from arguments

        # Check if file exists
        if [ ! -f "$FILE_PATH" ]; then
            print_error "File not found: $FILE_PATH"
            exit 1
        fi

        print_info "Merging climbs in: $FILE_PATH"
        echo ""

        # Run the merge script
        check_docker
        exec $COMPOSE_CMD run --rm climb-analyzer python scripts/merge_climbs_standalone.py "$FILE_PATH" "$@"
        ;;

    --merge-splits|-S)
        print_banner "Merging Split Climbs Across Files"

        # Check if files argument provided
        if [ -z "$2" ]; then
            print_error "No files specified"
            echo ""
            echo "Usage: ./climb-analyzer --merge-splits <files...>"
            echo "       ./climb-analyzer -S <files...>"
            echo ""
            echo "Examples:"
            echo "  ./climb-analyzer --merge-splits output/North_Carolina_*-*.xlsx"
            echo "  ./climb-analyzer -S output/Region_climbs_*.xlsx"
            echo ""
            exit 1
        fi

        shift  # Remove command from arguments
        FILES=("$@")  # Capture all remaining arguments as files

        # Validate at least 2 files
        if [ ${#FILES[@]} -lt 2 ]; then
            print_error "Need at least 2 files to merge"
            echo "Provide multiple split files (e.g., Region-1.xlsx, Region-2.xlsx)"
            exit 1
        fi

        # Check if files exist
        MISSING=0
        for FILE in "${FILES[@]}"; do
            if [ ! -f "$FILE" ]; then
                print_error "File not found: $FILE"
                MISSING=$((MISSING + 1))
            fi
        done

        if [ $MISSING -gt 0 ]; then
            print_error "$MISSING file(s) not found"
            exit 1
        fi

        print_info "Merging ${#FILES[@]} file(s)..."
        echo ""

        # Run the merge script
        check_docker
        exec $COMPOSE_CMD run --rm climb-analyzer python scripts/merge_split_climbs.py "${FILES[@]}"
        ;;

    --merge-regions|-X)
        print_banner "Merging Climbs Across Adjacent Regions"

        # Check if files argument provided
        if [ -z "$2" ]; then
            print_error "No files specified"
            echo ""
            echo "Usage: ./climb-analyzer --merge-regions <file-patterns...>"
            echo "       ./climb-analyzer -X <file-patterns...>"
            echo ""
            echo "Examples:"
            echo "  ./climb-analyzer --merge-regions \"output/state_*.xlsx\""
            echo "  ./climb-analyzer -X \"output/Idaho*.xlsx\" \"output/Oregon*.xlsx\""
            echo "  ./climb-analyzer -X \"output/*.xlsx\" --threshold 1.0 --auto-replace"
            echo ""
            echo "Notes:"
            echo "  • Only adjacent regions (within 10km) will be merged"
            echo "  • Non-adjacent regions are automatically skipped"
            echo "  • Supports wildcard patterns (use quotes!)"
            echo ""
            exit 1
        fi

        shift  # Remove command from arguments
        PATTERNS=("$@")  # Capture all remaining arguments as patterns

        print_info "Analyzing region files for adjacency..."
        echo ""

        # Run the batch merge script
        check_docker
        exec $COMPOSE_CMD run --rm climb-analyzer python scripts/batch_merge_regions.py "${PATTERNS[@]}"
        ;;

    # CLI argument passthrough - if first argument starts with -, pass all to climb_analyzer.py
    -*)
        check_docker

        # Special case: if launching GUI, need to expose ports and run detached
        if [[ "$1" == "-g" ]] || [[ "$1" == "--gui" ]]; then
            print_info "Starting GUI server in background..."
            CONTAINER_ID=$(run_compose run -d --rm --service-ports climb-analyzer python climb_analyzer_main.py "$@")
            if [ $? -eq 0 ]; then
                print_success "GUI server started successfully!"
                print_info "Container ID: ${CONTAINER_ID:0:12}"
                print_info "GUI available at: http://localhost:3000"
                print_info ""
                print_info "To stop the GUI: docker stop ${CONTAINER_ID:0:12}"
                print_info "To view logs: docker logs -f ${CONTAINER_ID:0:12}"
            else
                print_error "Failed to start GUI server"
                exit 1
            fi
        else
            # Use run_compose function to properly handle arguments with spaces
            run_compose run --rm climb-analyzer python climb_analyzer_main.py "$@"
        fi
        ;;

    # Legacy batch support (deprecated, show warning)
    batch)
        print_warning "Legacy batch command is deprecated. Use: ./climb-analyzer -r 'region1,region2,...'"
        check_docker
        shift  # Remove 'batch' from arguments
        echo ""
        exec $COMPOSE_CMD run --rm climb-analyzer python climb_analyzer_main.py --batch "$@"
        ;;

    # Legacy data_download (deprecated, show warning)
    data_download|download_data|download)
        print_warning "Legacy data_download command is deprecated. Use: ./climb-analyzer -D -r 'region'"
        check_docker
        echo ""
        exec $COMPOSE_CMD run --rm climb-analyzer python data_setup.py
        ;;

    shell|bash|sh)
        print_header "Opening Container Shell"
        check_docker
        print_info "Opening bash shell inside climb-analyzer container..."
        echo ""
        exec $COMPOSE_CMD run --rm climb-analyzer bash
        ;;

    logs|log)
        print_header "Viewing Climb Analyzer Logs"
        if [ -f "climb_analyzer.log" ]; then
            print_success "Showing recent logs from climb_analyzer.log"
            echo ""
            tail -100 climb_analyzer.log
        else
            print_warning "No log file found at climb_analyzer.log"
            echo ""
            print_info "Checking Docker logs..."
            $COMPOSE_CMD logs climb-analyzer 2>/dev/null || print_warning "No Docker logs available"
        fi
        ;;

    build|rebuild)
        print_header "Building Climb Analyzer Container"
        check_docker

        # Clear Python cache before building to ensure fresh code
        print_info "Clearing Python cache..."
        find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
        find . -name "*.pyc" -delete 2>/dev/null || true
        print_success "Python cache cleared"
        echo ""

        # Prune old climb-analyzer images to free disk space
        print_info "Pruning old climb-analyzer images..."
        # Remove dangling images first
        docker image prune -f >/dev/null 2>&1 || true
        # Remove old climb-analyzer images (keeps the current one until new build completes)
        OLD_IMAGES=$(docker images --filter "reference=*climb-analyzer*" --filter "dangling=false" -q 2>/dev/null | tail -n +2)
        if [ -n "$OLD_IMAGES" ]; then
            echo "$OLD_IMAGES" | xargs -r docker rmi -f 2>/dev/null || true
            print_success "Old images pruned"
        else
            print_success "No old images to prune"
        fi
        echo ""

        # Check for --no-cache flag
        BUILD_FLAGS=""
        if [[ "$2" == "--no-cache" ]]; then
            print_info "Building Docker image WITHOUT cache (full rebuild)..."
            BUILD_FLAGS="--no-cache"
        else
            print_info "Building Docker image (this may take 5-10 minutes)..."
        fi
        echo ""
        $COMPOSE_CMD build $BUILD_FLAGS climb-analyzer
        print_success "Build complete!"
        ;;

    stop)
        print_header "Stopping Containers"
        check_docker
        print_info "Stopping all climb analyzer containers..."
        $COMPOSE_CMD down
        print_success "All containers stopped"
        ;;

    clean|cleanup)
        print_header "Cleaning Up Containers"
        check_docker
        print_warning "This will remove stopped containers"
        read -p "Continue? [y/N] " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            $COMPOSE_CMD down
            docker system prune -f
            print_success "Cleanup complete"
        else
            print_info "Cleanup cancelled"
        fi
        ;;

    help|-h|--help)
        show_help
        ;;

    *)
        print_error "Unknown command: $1"
        echo ""
        echo "Run './climb-analyzer help' for usage information"
        exit 1
        ;;
esac
