# GitHub App Configuration for Cloud Cache
# Copy this file to .env and fill in your values

# GitHub App ID (from your GitHub App settings)
GITHUB_APP_ID=

# GitHub App Private Key (PEM format)
# You can either paste the entire key here with line breaks
# or point to a file path containing the key
GITHUB_PRIVATE_KEY=

# Example with inline key:
# GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
# MIIEpAIBAAKCAQEA...
# ...rest of key...
# -----END RSA PRIVATE KEY-----"

# Example with file path:
# GITHUB_PRIVATE_KEY_FILE=/path/to/private-key.pem

# DEPRECATED: NASA Earthdata Credentials (December 2025)
# All elevation datasets now use public sources - no credentials needed
# EARTHDATA_USER=
# EARTHDATA_PASS=

# Docker User Mapping (for file permissions)
# Set these to match your host user ID and group ID
# On Linux/macOS, run: id -u (for UID) and id -g (for GID)
# On macOS: typically UID=501, GID=20
# On Linux: typically UID=1000, GID=1000
HOST_UID=501
HOST_GID=20

# Docker group ID (for Docker socket access from container)
# Auto-detected by ./climb-analyzer script
# On Linux: run 'getent group docker' to find GID
# On macOS: Docker Desktop handles this automatically
DOCKER_GID=999